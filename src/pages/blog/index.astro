---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import NiagaraImage from '../../assets/niagara-cover.jpg';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={NiagaraImage} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			ul li a {
				display: flex;
				align-items: center;
				gap: 1rem;
				text-decoration: none;
				border-bottom: none;
				padding-bottom: 0.5rem;
				transition: 0.2s ease;
			}
			ul li img {
				width: 110px;
				height: 74px;
				object-fit: cover;
				border-radius: 8px;
				flex-shrink: 0;
			}
			.post-text {
				min-width: 0;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.3;
				font-size: 1.5rem;
			}
			.date {
				margin: 0.35rem 0 0 0;
				color: rgb(var(--gray));
				font-size: 1rem;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: var(--accent);
			}
			@media (max-width: 480px) {
				ul li img {
					width: 80px;
					height: 56px;
				}
				.title {
					font-size: 1.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={220} height={148} src={post.data.heroImage} alt="" />
									)}
									<div class="post-text">
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>