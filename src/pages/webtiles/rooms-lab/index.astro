---
// /webtiles/rooms-lab: where the Rooms lab was (a hidden page: HIDDEN_PAGES in astro.config.mjs, noindex, unlinked,
// left out of the sitemap). Rooms moved to Raku on Oct 29 2026 (a tab, raku:room), so this page only says so and
// links there (claude/raku-rooms-plan.md, RR11 to RR13; the owner's words, RR12). No room code, no sign-in, no
// tiles, no scripts: its own small policy below. The room's code lives in C:\thunderbird-cafe\rooms-lab (Raku takes
// it as a package); this page is the site's own now (rooms-lab's site\ and copy-to-site.mjs retired with it).
const RAKU = 'https://raku.lexicographer.space/';
// The policy goes on the built page only (Astro's dev server adds inline scripts of its own).
const csp = import.meta.env.PROD
	? "default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'"
	: null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		{csp && <meta http-equiv="Content-Security-Policy" content={csp} />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="referrer" content="no-referrer" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Rooms have moved to Raku · thunderbird.cafe</title>
		<meta name="description" content="Rooms are now a tab in Raku, the browser for web tiles." />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
		<style is:global>
			html, body { margin: 0; background: #171411; }
			body { color: #efe6d8; font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color-scheme: dark; }
			main { max-width: 560px; margin: 0 auto; padding: 56px 16px 64px; }
			h1 { font-size: 1.6rem; margin: 0 0 14px; color: #8fd9cd; font-weight: 650; }
			p { margin: 0 0 16px; }
			.go { display: inline-block; margin: 6px 0 22px; padding: 10px 18px; border-radius: 8px; background: #2fa596; color: #06201c; font-weight: 600; text-decoration: none; }
			.go:hover, .go:focus-visible { background: #3fb8a8; }
			.go:focus-visible { outline: 2px solid #8fd9cd; outline-offset: 2px; }
			.how { color: #b9ad9c; font-size: 15px; }
		</style>
	</head>
	<body>
		<main>
			<h1>Rooms have moved to Raku</h1>
			<p>Voice, one shared screen, and tiles opened for everyone, for small meetups among friends: rooms are now a tab in Raku, the browser for web tiles.</p>
			<a class="go" href={RAKU}>Open Raku</a>
			<p class="how">In Raku, open the Rooms card on the first screen, start a room, and send its invite link.</p>
		</main>
	</body>
</html>
